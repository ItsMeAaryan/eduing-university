rules_version = '2';

// EDUING — one Storage rules file for the whole project (same copy in eduing-student
// and eduing-university). Files are opened through download URLs, so these rules
// mainly decide who may upload where.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function userData() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function hasUserDoc() { return isSignedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasUserDoc() && userData().get('role', '') in ['eduing_admin', 'super_admin']; }
    // The university account itself or one of its staff (approval is checked at login).
    function isUni(uniId) {
      return isSignedIn() && (request.auth.uid == uniId
        || (hasUserDoc() && userData().get('role', '') == 'uni_staff' && userData().get('universityId', '') == uniId)
        || isAdmin());
    }
    function isUniAccount() { return hasUserDoc() && userData().get('role', '') in ['uni_admin', 'uni_staff']; }

    function isDocUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Profile photo
    match /users/{uid}/profile_photo {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Marksheets, ID, photo — website: users/{uid}/documents/{docId}; app: users/{uid}/documents/{docId}_{file}
    match /users/{uid}/documents/{docId} {
      allow read: if isOwner(uid) || isUniAccount() || isAdmin();
      allow write: if isOwner(uid) && (request.resource == null || isDocUpload());
    }

    // Fee receipts uploaded by the student: users/{uid}/payments/{appId}_{timestamp}.{ext}
    match /users/{uid}/payments/{fileName} {
      allow read: if isOwner(uid) || isUniAccount() || isAdmin();
      allow create: if isOwner(uid) && isDocUpload();
    }

    // University files: logo, offer letters, admit cards, enrollment certificates
    //   universities/{uniId}/logo/…, universities/{uniId}/applications/{appId}/…
    match /universities/{uniId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isUni(uniId) && (request.resource == null || request.resource.size < 15 * 1024 * 1024);
    }

    // Legacy, read-only
    match /student_profiles/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /documents/{uid}/{fileName} {
      allow read: if isOwner(uid) || isUniAccount() || isAdmin();
      allow write: if false;
    }
  }
}
