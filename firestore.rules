rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - authenticated users read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Student Profiles collection
    match /student_profiles/{profileId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == profileId || 
        request.auth.uid == resource.data.userId || 
        request.auth.uid == request.resource.data.userId
      );
    }

    match /profile/{profileId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == profileId || 
        request.auth.uid == resource.data.userId || 
        request.auth.uid == request.resource.data.userId
      );
    }

    // Universities collection - read allowed for authenticated users, write for university owner
    match /universities/{universityId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == universityId || 
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == request.resource.data.universityId
      );

      // Staff subcollection
      match /staff/{staffId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == universityId ||
          request.auth.uid == staffId
        );
      }

      // Invitations subcollection
      match /invitations/{inviteId} {
        allow read, write: if request.auth != null && request.auth.uid == universityId;
      }

      // Audit logs subcollection
      match /audit_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == universityId;
      }
    }

    // Applications collection - read/write for owner university or candidate student
    match /applications/{appId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.userId
      );
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.studentId ||
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.universityId
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.userId
      );
    }

    // Programs collection - public read catalog, university write
    match /programs/{programId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == request.resource.data.universityId ||
        request.auth.uid == resource.data.uniId ||
        request.auth.uid == request.resource.data.uniId
      );
    }

    // Notifications collection - user or university scoped
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.universityId
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.universityId
      );
    }

    // Documents collection - user/student/university scoped
    match /documents/{docId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.studentId ||
        request.auth.uid == request.resource.data.universityId
      );
    }

    // Payments collection - user/student/university scoped
    match /payments/{paymentId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.studentId ||
        request.auth.uid == request.resource.data.universityId
      );
    }

    // Scholarships collection - public read, admin write
    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Seat Allotments collection - university/student scoped
    match /seat_allotments/{allotmentId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == resource.data.studentId
      );
      allow write: if request.auth != null && (
        request.auth.uid == request.resource.data.universityId ||
        request.auth.uid == resource.data.universityId
      );
    }

    // Exams / Admit cards collection
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == request.resource.data.universityId
      );
    }
  }
}
